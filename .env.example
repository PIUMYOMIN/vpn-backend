# Server
PORT=8080
APP_URL=https://yourdomain.com

# Database: replace user and password with your local PostgreSQL credentials.
DATABASE_URL=postgres://user:password@localhost:5432/vpndb?sslmode=disable

# JWT
JWT_SECRET=replace-with-a-long-random-secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h

# WireGuard
WG_INTERFACE=wg0
WG_SERVER_PUBLIC_KEY=replace-with-server-public-key
WG_ENDPOINT=vpn.yourdomain.com
WG_PORT=51820
WG_DNS=1.1.1.1

# AdMob
ADMOB_SSV_KEYS_URL=https://www.gstatic.com/admob/reward/verifier-keys.json

# Email (Resend)
RESEND_API_KEY=replace-with-resend-api-key
